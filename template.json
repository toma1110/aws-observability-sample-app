{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM-authenticated order processing sample for observability practice.",
  "Parameters": {
    "StackPrefix": {"Type": "String", "AllowedPattern": "[a-zA-Z][a-zA-Z0-9-]{2,30}"},
    "LogRetentionDays": {"Type": "Number", "Default": 3, "AllowedValues": [1, 3, 5, 7, 14]}
  },
  "Resources": {
    "FunctionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{"PolicyName": "WriteOwnLogs", "PolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${FunctionLogGroup.Arn}:*"}}]}}],
        "Tags": [{"Key": "SampleOwner", "Value": "aws-observability-sample-app"}]
      }
    },
    "FunctionLogGroup": {"Type": "AWS::Logs::LogGroup", "Properties": {"LogGroupName": {"Fn::Sub": "/aws/lambda/${StackPrefix}"}, "RetentionInDays": {"Ref": "LogRetentionDays"}, "Tags": [{"Key": "SampleOwner", "Value": "aws-observability-sample-app"}]}},
    "OrderFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {"Ref": "StackPrefix"},
        "Runtime": "python3.12",
        "Handler": "index.handler",
        "Role": {"Fn::GetAtt": ["FunctionRole", "Arn"]},
        "Timeout": 8,
        "MemorySize": 128,
        "Code": {"ZipFile": "RENDER_APP_SOURCE"},
        "Tags": [{"Key": "SampleOwner", "Value": "aws-observability-sample-app"}]
      }
    },
    "FunctionUrl": {"Type": "AWS::Lambda::Url", "Properties": {"AuthType": "AWS_IAM", "TargetFunctionArn": {"Fn::GetAtt": ["OrderFunction", "Arn"]}}}
  },
  "Outputs": {
    "FunctionName": {"Value": {"Ref": "OrderFunction"}},
    "FunctionUrl": {"Value": {"Fn::GetAtt": ["FunctionUrl", "FunctionUrl"]}},
    "LogGroupName": {"Value": {"Ref": "FunctionLogGroup"}},
    "RoleName": {"Value": {"Ref": "FunctionRole"}}
  }
}
